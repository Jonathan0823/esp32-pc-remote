{
  "info": {
    "name": "ESP32 Media Daemon HTTPS",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "requestId",
      "value": ""
    },
    {
      "key": "issuedAt",
      "value": ""
    },
    {
      "key": "expiresAt",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Media - pause (fresh request)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const now = Date.now();",
              "pm.collectionVariables.set('requestId', pm.variables.replaceIn('{{$guid}}').replaceAll('-', '').toLowerCase());",
              "pm.collectionVariables.set('issuedAt', String(now));",
              "pm.collectionVariables.set('expiresAt', String(now + 5000));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 and correlated response', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('requestId')); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"{{requestId}}\",\n  \"cmd\": \"pause\",\n  \"issued_at_ms\": {{issuedAt}},\n  \"expires_at_ms\": {{expiresAt}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/v1/media"
      }
    },
    {
      "name": "Custom action (fresh request)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const now = Date.now();",
              "pm.collectionVariables.set('requestId', pm.variables.replaceIn('{{$guid}}').replaceAll('-', '').toLowerCase());",
              "pm.collectionVariables.set('issuedAt', String(now));",
              "pm.collectionVariables.set('expiresAt', String(now + 5000));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"{{requestId}}\",\n  \"action_id\": \"{{actionId}}\",\n  \"issued_at_ms\": {{issuedAt}},\n  \"expires_at_ms\": {{expiresAt}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/v1/actions"
      }
    },
    {
      "name": "Invalid token (expect 401)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const now = Date.now();",
              "pm.collectionVariables.set('requestId', pm.variables.replaceIn('{{$guid}}').replaceAll('-', '').toLowerCase());",
              "pm.collectionVariables.set('issuedAt', String(now));",
              "pm.collectionVariables.set('expiresAt', String(now + 5000));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer invalid"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"id\":\"{{requestId}}\",\"cmd\":\"pause\",\"issued_at_ms\":{{issuedAt}},\"expires_at_ms\":{{expiresAt}}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/v1/media"
      }
    },
    {
      "name": "Expired request (expect 410)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const issued = Date.now() - 10000;",
              "pm.collectionVariables.set('requestId', pm.variables.replaceIn('{{$guid}}').replaceAll('-', '').toLowerCase());",
              "pm.collectionVariables.set('issuedAt', String(issued));",
              "pm.collectionVariables.set('expiresAt', String(issued + 5000));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"id\":\"{{requestId}}\",\"cmd\":\"pause\",\"issued_at_ms\":{{issuedAt}},\"expires_at_ms\":{{expiresAt}}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/v1/media"
      }
    },
    {
      "name": "Duplicate ID (send twice; second expects 409)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const now = Date.now();",
              "pm.collectionVariables.set('issuedAt', String(now));",
              "pm.collectionVariables.set('expiresAt', String(now + 5000));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"id\":\"00000000000000000000000000000001\",\"cmd\":\"pause\",\"issued_at_ms\":{{issuedAt}},\"expires_at_ms\":{{expiresAt}}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/v1/media"
      }
    }
  ]
}
